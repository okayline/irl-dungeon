{
  // The Worker's name must match the one in the Cloudflare dashboard.
  "name": "irl-dungeon",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The Worker serves the page (public/) and the API (/api/*) from one origin.
  "assets": { "directory": "public", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // created with the Cloudflare tools on 2026-10-15 (HST), region OC.
    { "binding": "DB", "database_name": "irl-dungeon-db", "database_id": "9728ba1a-49a9-4ebb-8a2e-af1146508a59" }
  ]
}
