{
  // The Worker's name must match the one in the Cloudflare dashboard.
  "name": "irl-dungeon",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The Worker serves the page (public/) and the API (/api/*) from one origin.
  "assets": { "directory": "public", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // create with: npx wrangler d1 create irl-dungeon-db   (then replace the placeholder below with its id)
    // The old database was deleted, so this is a new one. Deploying with the placeholder fails on purpose.
    { "binding": "DB", "database_name": "irl-dungeon-db", "database_id": "PASTE-ID-FROM-d1-create" }
  ]
}
